.impeccable/
__pycache__/
*.pyc
.DS_Store
rl/vendor/

# built tasks are regenerated, not committed; secrets never leave this machine
rl/tasks/
rl/splits/secrets/
.venv/

# run scratch: console logs and applied patches (rl/runs/README.md)
rl/runs/**/*.log
rl/runs/**/*.patch
# raw run outputs stay local; only run records (records.jsonl) are committed (rl/runs/README.md)
rl/runs/**/traces/
rl/runs/**/jobs/
rl/runs/**/results.jsonl
rl/runs/**/errors.jsonl

# Claude subscription token for Harbor runs (setup_oauth.sh)
.oauth.env

# packaging and tool caches
*.egg-info/
dist/
.pytest_cache/
.ruff_cache/
